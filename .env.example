# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JARVIS_API_KEY=replace-with-generated-secret
JARVIS_DB=data/jarvis.db
# Optional separate pgvector memory API; requires explicit migration and PG DSN.
JARVIS_POSTGRES_MEMORY_ENABLED=false
# Validated startup timeout, >0 and <=60 seconds. Readiness uses at most2seconds.
JARVIS_SQLITE_TIMEOUT_SECONDS=15
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
# The following adapter can only GET actual existing AutoLogika routes.
AUTOLOGIKA_READONLY_ENABLED=false
AUTOLOGIKA_URL=http://127.0.0.1:8787
AUTOLOGIKA_PIN=
# For Docker on Windows use http://host.docker.internal:8787 as URL.
# Generate a separate secret before starting optional n8n profile.
N8N_ENCRYPTION_KEY=
# Pin a reviewed current image digest before exposing n8n beyond localhost.
N8N_IMAGE=docker.n8n.io/n8nio/n8n:stable

# Network access for NEW plugin/HA readers: allow only the precise LAN/subnet needed.
# Hostnames are resolved and pinned to an allowed IP. Metadata/link-local are denied.
JARVIS_NETWORK_ALLOWLIST=127.0.0.0/8,::1/128
# Create in Control Center > Access and tokens. Do not put owner key here.
JARVIS_SCHEDULER_TOKEN=
HA_READONLY_ENABLED=false
HA_URL=http://127.0.0.1:8123
HA_TOKEN=
HA_ALLOWED_ENTITIES=sensor.workshop_temperature
# Exact public HTTPS origin; never inferred from incoming Host/Forwarded headers.
TWILIO_WEBHOOK_ENABLED=false
TWILIO_PUBLIC_ORIGIN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
WHATSAPP_ALLOWED_SENDERS=
# Example plugin secret; allowed names start with JARVIS_PLUGIN_SECRET_.
# JARVIS_PLUGIN_SECRET_WEATHER=

# Models are explicit. Changing this list does not install or download a model.
OLLAMA_ALLOWED_MODELS=qwen2.5:3b
JARVIS_ALLOW_CLOUD_MODELS=false
# Immutable local copy; prepare using scripts/import_autologika.py.
AUTOLOGIKA_SNAPSHOT_ENABLED=false
AUTOLOGIKA_SNAPSHOT_PATH=data/autologika/workshop.snapshot.sqlite3

# Optional explicit-upload Wyoming speech services. No background microphone.
JARVIS_VOICE_ENABLED=false
WYOMING_STT_URI=tcp://127.0.0.1:10300
WYOMING_TTS_URI=tcp://127.0.0.1:10200
WYOMING_TTS_VOICE=
# Optional semantic indexing of manually saved notes. No automatic downloads.
JARVIS_EMBEDDINGS_ENABLED=false
OLLAMA_EMBED_URL=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=
MEMORY_EMBEDDING_REVISION=1

# Optional model analysis for the owner-only receptionist laboratory.
JARVIS_RECEPTION_AI_ENABLED=false
OLLAMA_RECEPTION_URL=http://127.0.0.1:11434
OLLAMA_RECEPTION_MODEL=qwen2.5:3b

# Local account session TTL, 5..1440 minutes; opaque tokens are shown once.
JARVIS_SESSION_MINUTES=60
# Process-local request limits per real peer; both API prefixes share budgets.
JARVIS_API_REQUESTS_PER_MINUTE=600
JARVIS_LOGIN_ATTEMPTS_PER_MINUTE=10
# Comma-separated HTTPS origins (or localhost HTTP for development), never '*'.
JARVIS_CORS_ORIGINS=

# Separate, optional JARVIS PostgreSQL foundation; never the AutoLogika database.
# Use jarvis_runtime with no ownership/BYPASSRLS. Blank keeps it disabled.
# Loopback example ONLY: postgresql://jarvis_runtime:<password>@127.0.0.1:<port>/jarvis?sslmode=disable
# Remote requires sslmode=verify-full and a trusted CA; migration DSN belongs only to the CLI.
JARVIS_POSTGRES_DSN=
JARVIS_POSTGRES_CONNECT_TIMEOUT_SECONDS=5
JARVIS_POSTGRES_STATEMENT_TIMEOUT_MS=5000
JARVIS_POSTGRES_LOCK_TIMEOUT_MS=1000

# Optional OpenAI text provider. All activation and prices must be set deliberately.
# Never enable against a real paid account as part of automated tests.
JARVIS_OPENAI_ENABLED=false
JARVIS_OPENAI_API_KEY=
JARVIS_OPENAI_URL=https://api.openai.com
JARVIS_OPENAI_MODEL=gpt-5.4-mini-2026-03-17
JARVIS_LLM_MAX_OUTPUT_TOKENS=1024
# Explicit owner-only read-tool API, separate from ordinary chat/voice. Default OFF.
JARVIS_TOOL_CHAT_ENABLED=false
# Required positive USD rates per1M tokens, reviewed against your current tariff.
JARVIS_OPENAI_INPUT_USD_PER_MILLION=
JARVIS_OPENAI_OUTPUT_USD_PER_MILLION=
JARVIS_OPENAI_MAX_REQUEST_USD=
# Preflight reserves the full400000-token context plus the configured output cap.
# This is a per-request limit, not a daily/aggregate spending limit.
