{
  "name": "@autologika/openclaw-jarvis-readonly",
  "version": "0.1.0-experiment.1",
  "private": true,
  "description": "Pinned, read-only OpenClaw bridge to the JARVIS AutoLogika and Home Assistant adapters",
  "type": "module",
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "typebox": "1.3.34"
  },
  "devDependencies": {
    "openclaw": "2026.10.7",
    "typescript": "7.1.0-dev.20260922.1"
  },
  "peerDependencies": {
    "openclaw": "2026.10.7"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.22.1 <25 || >=26.12.1"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ]
  }
}
